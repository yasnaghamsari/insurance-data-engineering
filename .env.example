# Copy to .env for local (non-Docker) runs. Docker Compose sets its own
# equivalents in docker-compose.yml / dags/insurance_pipeline_dag.py.

# Where the pipeline reads sample data / schema files from.
DATA_ROOT=./data/samples
SCHEMA_ROOT=./data/schemas

# Where local Delta tables are written.
WAREHOUSE_DIR=./warehouse

# ClickHouse connection used by insurance_pipeline.clickhouse_loader.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=insurance
