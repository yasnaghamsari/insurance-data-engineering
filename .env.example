# Copy to .env for local (non-Docker) runs. Docker Compose sets its own
# equivalents in docker-compose.yml / dags/insurance_pipeline_dag.py.

# Where the pipeline reads sample data / schema files from.
DATA_ROOT=./data/samples
SCHEMA_ROOT=./data/schemas

# Where Bronze reads policies and claims from: "files" (the sample files under
# DATA_ROOT) or "databases" (MySQL + MongoDB, using the settings below).
SOURCE_MODE=files

# MySQL source for policies (SOURCE_MODE=databases only).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=insurance
MYSQL_POLICIES_TABLE=policies

# MongoDB source for claims (SOURCE_MODE=databases only).
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=insurance
MONGO_CLAIMS_COLLECTION=claims

# Where local Delta tables are written.
WAREHOUSE_DIR=./warehouse

# ClickHouse connection used by insurance_pipeline.clickhouse_loader.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=insurance
